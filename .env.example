# Local secrets for frontend tooling and deploy scripts. Copy to .env and fill in; .env is git-ignored.
# Nothing here is compiled into the app: values in src/environments/ ship to every browser,
# so never put a secret there.

# Firebase CI token for non-interactive `firebase deploy` (optional; `firebase login` also works)
FIREBASE_TOKEN=

# Chrome binary for headless Karma tests when Google Chrome is not installed (optional)
CHROME_BIN=
